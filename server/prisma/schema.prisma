// ============================================================
// 🗃️ Prisma Schema — Nexus Auto Database (Production Dealership)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────

enum Role {
  USER     // Khách hàng tạo tài khoản
  ADMIN    // Quản lý hệ thống toàn quyền
  SALES    // Nhân viên bán hàng / tư vấn
}

enum VehicleStatus {
  AVAILABLE   // Sẵn sàng bán
  RESERVED    // Đã nhận cọc giữ chỗ
  SOLD        // Đã hoàn tất bán
  UNAVAILABLE // Tạm ngưng kinh doanh / chờ bảo dưỡng
}

enum VehicleCondition {
  NEW  // Xe mới 100%
  USED // Xe đã qua sử dụng / Xe lướt
}

enum Drivetrain {
  FWD     // Cầu trước
  RWD     // Cầu sau
  AWD     // Bốn bánh toàn thời gian
  FOUR_WD // Bốn bánh bán thời gian (4x4)
}

enum LeadType {
  TEST_DRIVE // Lái thử
  INQUIRY    // Xin báo giá
  FINANCE    // Tư vấn trả góp
}

enum LeadStatus {
  NEW        // Vừa gửi form
  CONTACTED  // Đã gọi điện
  QUALIFIED  // Khách rất tiềm năng
  LOST       // Khách đổi ý / Mua chỗ khác
  CONVERTED  // Chốt sale thành công
}

enum FuelType {
  GASOLINE
  DIESEL
  ELECTRIC
  HYBRID
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum TestDriveStatus {
  PENDING   // Chờ xác nhận
  CONFIRMED // Đã xác nhận
  COMPLETED // Đã hoàn thành
  CANCELLED // Đã hủy
}

enum FinanceStatus {
  PENDING   // Chờ duyệt
  APPROVED  // Đã duyệt
  REJECTED  // Từ chối
  ACTIVE    // Đang trả góp
  COMPLETED // Đã trả xong
}

enum PaymentMethod {
  CASH          // Tiền mặt
  BANK_TRANSFER // Chuyển khoản
  CREDIT_CARD   // Thẻ tín dụng
  INSTALLMENT   // Trả góp
}

enum PaymentStatus {
  PENDING    // Chờ xác nhận
  COMPLETED  // Đã thanh toán
  FAILED     // Thất bại
  REFUNDED   // Đã hoàn tiền
}

enum DepositStatus {
  PENDING    // Chờ xác nhận
  CONFIRMED  // Đã nhận cọc thành công
  EXPIRED    // Hết hạn giữ chỗ
  REFUNDED   // Đã hoàn cọc
}

enum QuotationStatus {
  DRAFT      // Nháp
  SENT       // Đã gửi khách hàng
  ACCEPTED   // Khách đồng ý
  REJECTED   // Khách từ chối
  EXPIRED    // Hết hạn báo giá
}

enum InvoiceStatus {
  DRAFT      // Nháp
  ISSUED     // Đã xuất hóa đơn
  PAID       // Đã thanh toán đầy đủ
  CANCELLED  // Đã hủy hóa đơn
}

// ── Models ────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  avatarUrl    String?  @map("avatar_url")
  role         Role     @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  myLeads       Lead[]                @relation("CustomerLeads")
  assignedLeads Lead[]                @relation("SalesLeads")
  testDrives    TestDrive[]           @relation("TestDriveSales")
  deposits      Deposit[]             @relation("DepositCreator")
  quotations    Quotation[]           @relation("QuotationCreator")
  invoices      Invoice[]             @relation("InvoiceCreator")
  blogPosts     BlogPost[]            @relation("BlogAuthor")
  notifications Notification[]        @relation("UserNotifications")
  auditLogs     AuditLog[]            @relation("UserAuditLogs")
  interactions  CustomerInteraction[] @relation("InteractionCreator")

  @@map("users")
}

model Brand {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  logoUrl  String? @map("logo_url")
  country  String?

  vehicles Vehicle[]

  @@map("brands")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  vehicles Vehicle[]

  @@map("categories")
}

model Vehicle {
  id            String           @id @default(uuid())
  vin           String?          @unique
  engineNumber  String?          @map("engine_number")
  licensePlate  String?          @map("license_plate")
  brandId       Int              @map("brand_id")
  categoryId    Int              @map("category_id")
  model         String
  trim          String?
  year          Int
  condition     VehicleCondition @default(NEW)
  price         Decimal          @db.Decimal(12, 2)
  costPrice     Decimal?         @map("cost_price") @db.Decimal(12, 2)
  mileage       Int              @default(0)
  fuelType      FuelType         @map("fuel_type")
  transmission  Transmission
  drivetrain    Drivetrain?
  color         String
  interiorColor String?          @map("interior_color")
  engine        String?
  seats         Int              @default(5)
  warrantyInfo  String?          @map("warranty_info")
  description   String?          @db.Text
  status        VehicleStatus    @default(AVAILABLE)
  featured      Boolean          @default(false)
  isDeleted     Boolean          @default(false) @map("is_deleted")
  deletedAt     DateTime?        @map("deleted_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relations
  brand               Brand                @relation(fields: [brandId], references: [id])
  category            Category             @relation(fields: [categoryId], references: [id])
  images              VehicleImage[]
  leads               Lead[]
  testDrives          TestDrive[]
  financeApplications FinanceApplication[]
  payments            Payment[]
  deposits            Deposit[]
  quotations          Quotation[]
  invoices            Invoice[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@index([year])
  @@index([isDeleted])
  @@map("vehicles")
}

model VehicleImage {
  id        Int     @id @default(autoincrement())
  vehicleId String  @map("vehicle_id")
  imageUrl  String  @map("image_url")
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

model Lead {
  id           String     @id @default(uuid())
  vehicleId    String?    @map("vehicle_id")
  customerId   String?    @map("customer_id")
  assignedToId String?    @map("assigned_to_id")
  guestName    String?    @map("guest_name")
  guestPhone   String?    @map("guest_phone")
  guestEmail   String?    @map("guest_email")
  type         LeadType
  status       LeadStatus @default(NEW)
  preferredDate DateTime? @map("preferred_date")
  notes        String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  customer     User?                 @relation("CustomerLeads", fields: [customerId], references: [id])
  assignedTo   User?                 @relation("SalesLeads", fields: [assignedToId], references: [id])
  vehicle      Vehicle?              @relation(fields: [vehicleId], references: [id])
  interactions CustomerInteraction[]

  @@index([status])
  @@index([assignedToId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([createdAt])
  @@map("leads")
}

model TestDrive {
  id            String          @id @default(uuid())
  vehicleId     String          @map("vehicle_id")
  customerName  String          @map("customer_name")
  customerPhone String          @map("customer_phone")
  customerEmail String?         @map("customer_email")
  scheduledDate DateTime        @map("scheduled_date")
  scheduledTime String          @map("scheduled_time")
  status        TestDriveStatus @default(PENDING)
  notes         String?         @db.Text
  assignedToId  String?         @map("assigned_to_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  assignedTo User?   @relation("TestDriveSales", fields: [assignedToId], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
  @@map("test_drives")
}

model FinanceApplication {
  id             String        @id @default(uuid())
  vehicleId      String        @map("vehicle_id")
  customerName   String        @map("customer_name")
  customerPhone  String        @map("customer_phone")
  customerEmail  String?       @map("customer_email")
  monthlyIncome  Decimal?      @map("monthly_income") @db.Decimal(12, 2)
  loanAmount     Decimal       @map("loan_amount") @db.Decimal(12, 2)
  loanTermMonths Int           @map("loan_term_months")
  interestRate   Decimal?      @map("interest_rate") @db.Decimal(5, 2)
  downPayment    Decimal?      @map("down_payment") @db.Decimal(12, 2)
  status         FinanceStatus @default(PENDING)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@map("finance_applications")
}

model Deposit {
  id            String        @id @default(uuid())
  vehicleId     String        @map("vehicle_id")
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  customerEmail String?       @map("customer_email")
  amount        Decimal       @db.Decimal(12, 2)
  status        DepositStatus @default(PENDING)
  expiresAt     DateTime?     @map("expires_at")
  notes         String?       @db.Text
  createdById   String?       @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  createdBy User?     @relation("DepositCreator", fields: [createdById], references: [id])
  payments  Payment[]

  @@index([vehicleId])
  @@index([status])
  @@index([createdById])
  @@map("deposits")
}

model Quotation {
  id              String          @id @default(uuid())
  vehicleId       String          @map("vehicle_id")
  customerName    String          @map("customer_name")
  customerPhone   String          @map("customer_phone")
  customerEmail   String?         @map("customer_email")
  vehiclePrice    Decimal         @map("vehicle_price") @db.Decimal(12, 2)
  registrationFee Decimal?        @map("registration_fee") @db.Decimal(12, 2)
  insuranceFee    Decimal?        @map("insurance_fee") @db.Decimal(12, 2)
  accessories     Decimal?        @db.Decimal(12, 2)
  discount        Decimal?        @db.Decimal(12, 2)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(12, 2)
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?       @map("valid_until")
  notes           String?         @db.Text
  createdById     String?         @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  createdBy User?   @relation("QuotationCreator", fields: [createdById], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@map("quotations")
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  vehicleId       String        @map("vehicle_id")
  customerName    String        @map("customer_name")
  customerPhone   String        @map("customer_phone")
  customerEmail   String?       @map("customer_email")
  customerAddress String?       @map("customer_address") @db.Text
  subtotal        Decimal       @db.Decimal(12, 2)
  tax             Decimal?      @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  status          InvoiceStatus @default(DRAFT)
  issuedAt        DateTime?     @map("issued_at")
  notes           String?       @db.Text
  createdById     String?       @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  createdBy User?     @relation("InvoiceCreator", fields: [createdById], references: [id])
  payments  Payment[]

  @@index([vehicleId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

model Payment {
  id            String        @id @default(uuid())
  vehicleId     String        @map("vehicle_id")
  invoiceId     String?       @map("invoice_id")
  depositId     String?       @map("deposit_id")
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  customerEmail String?       @map("customer_email")
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id")
  notes         String?       @db.Text
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  deposit Deposit? @relation(fields: [depositId], references: [id])

  @@index([vehicleId])
  @@index([invoiceId])
  @@index([depositId])
  @@index([status])
  @@map("payments")
}

model Promotion {
  id            String   @id @default(uuid())
  title         String
  description   String?  @db.Text
  imageUrl      String?  @map("image_url")
  discountType  String   @map("discount_type")
  discountValue Decimal  @map("discount_value") @db.Decimal(12, 2)
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([startDate, endDate])
  @@map("promotions")
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String?   @db.Text
  coverImage  String?   @map("cover_image")
  authorId    String    @map("author_id")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author User @relation("BlogAuthor", fields: [authorId], references: [id])

  @@index([slug])
  @@index([isPublished])
  @@map("blog_posts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  linkUrl   String?  @map("link_url")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   String?  @db.Text
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CustomerInteraction {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  userId    String?  @map("user_id")
  type      String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation("InteractionCreator", fields: [userId], references: [id])

  @@index([leadId])
  @@map("customer_interactions")
}
